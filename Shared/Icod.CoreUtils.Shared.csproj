<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<LangVersion>13.0</LangVersion>
		<OutputType>Library</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<OutputPath>..\bin\$(Configuration)\</OutputPath>
		<AssemblyName>Icod.CoreUtils.Shared</AssemblyName>
		<RootNamespace>Icod.CoreUtils.Shared</RootNamespace>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(PlatformTarget)' == '' ">
		<PlatformTarget>AnyCPU</PlatformTarget>
	</PropertyGroup>
	<!--
		INTENTIONALLY OMITTED: <ProjectReference> to support batch editing with sed by line #.
	-->
	<PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
		<ErrorReport>prompt</ErrorReport>
		<WarningLevel>2</WarningLevel>
		<DebugSymbols>true</DebugSymbols>
		<DebugType>full</DebugType>
		<Optimize>false</Optimize>
		<DefineConstants>DEBUG;TRACE</DefineConstants>
		<SignAssembly>false</SignAssembly>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)' == 'Staging' ">
		<ErrorReport>prompt</ErrorReport>
		<WarningLevel>3</WarningLevel>
		<DebugSymbols>true</DebugSymbols>
		<DebugType>full</DebugType>
		<Optimize>false</Optimize>
		<DefineConstants>TRACE</DefineConstants>
		<SignAssembly>false</SignAssembly>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
		<ErrorReport>prompt</ErrorReport>
		<WarningLevel>4</WarningLevel>
		<DebugType>pdbonly</DebugType>
		<Optimize>true</Optimize>
		<SignAssembly>false</SignAssembly>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
	</PropertyGroup>
	<PropertyGroup>
		<PackageVersion>1.0.0-WIP1</PackageVersion>
		<PackageReleaseNotes>Initial release of Icod.CoreUtils.Shared</PackageReleaseNotes>
		<Authors>Timothy J. Bruce</Authors>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
		<PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<IncludeContentInPack>true</IncludeContentInPack>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="README.md" CopyToOutputDirectory="Always">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</Content>
		<Content Include="LICENSE" CopyToOutputDirectory="Always">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</Content>
	</ItemGroup>

	<Target Name="RmContent" AfterTargets="Clean" BeforeTargets="Build" Condition=" '$(OutDir)' != '' ">
		<Delete ContinueOnError="false" Files="$(OutDir)\$(AssemblyName).LICENSE.txt" Condition="Exists('$(OutDir)\$(AssemblyName).LICENSE.txt')" />
		<Delete ContinueOnError="false" Files="$(OutDir)\$(AssemblyName).README.md" Condition="Exists('$(OutDir)\$(AssemblyName).README.md')" />
	</Target>
	<Target Name="MvContent" AfterTargets="Build" Condition=" '$(OutDir)' != '' ">
		<Move ContinueOnError="false" SourceFiles="$(OutDir)\LICENSE" DestinationFiles="$(OutDir)\$(AssemblyName).LICENSE.txt" />
		<Move ContinueOnError="false" SourceFiles="$(OutDir)\README.md" DestinationFiles="$(OutDir)\$(AssemblyName).README.md" />
	</Target>
</Project>
