<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<LangVersion>13.0</LangVersion>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<OutputPath>..\bin\$(Configuration)\</OutputPath>
		<AssemblyName>stdbuf</AssemblyName>
		<RootNamespace>Icod.CoreUtils.StdBuf</RootNamespace>
		<StdBufNativeCompiler Condition=" '$(StdBufNativeCompiler)' == '' ">cc</StdBufNativeCompiler>
		<StdBufNativeShimPath>$(IntermediateOutputPath)libicodstdbuf.so</StdBufNativeShimPath>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(PlatformTarget)' == '' ">
		<PlatformTarget>AnyCPU</PlatformTarget>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\Shared\Icod.CoreUtils.Shared.csproj" />
	</ItemGroup>
	<PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
		<ErrorReport>prompt</ErrorReport>
		<WarningLevel>2</WarningLevel>
		<DebugSymbols>true</DebugSymbols>
		<DebugType>full</DebugType>
		<Optimize>false</Optimize>
		<DefineConstants>DEBUG;TRACE</DefineConstants>
		<SignAssembly>false</SignAssembly>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)' == 'Staging' ">
		<ErrorReport>prompt</ErrorReport>
		<WarningLevel>3</WarningLevel>
		<DebugSymbols>true</DebugSymbols>
		<DebugType>full</DebugType>
		<Optimize>false</Optimize>
		<DefineConstants>TRACE</DefineConstants>
		<SignAssembly>false</SignAssembly>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
		<ErrorReport>prompt</ErrorReport>
		<WarningLevel>4</WarningLevel>
		<DebugType>pdbonly</DebugType>
		<Optimize>true</Optimize>
		<SignAssembly>false</SignAssembly>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
	</PropertyGroup>
	<Target Name="BuildStdBufNativeShim"
		BeforeTargets="CopyFilesToOutputDirectory"
		Condition="$([MSBuild]::IsOSPlatform('Linux'))">
		<MakeDir Directories="$(IntermediateOutputPath);$(TargetDir)" />
		<Exec Command="&quot;$(StdBufNativeCompiler)&quot; -shared -fPIC -O2 -std=c11 -Wall -Wextra -Werror -o &quot;$(StdBufNativeShimPath)&quot; &quot;$(MSBuildProjectDirectory)/native/icod_stdbuf.c&quot;" />
		<Copy SourceFiles="$(StdBufNativeShimPath)" DestinationFiles="$(TargetDir)libicodstdbuf.so" SkipUnchangedFiles="true" />
	</Target>
	<Target Name="PublishStdBufNativeShim"
		BeforeTargets="ComputeFilesToPublish"
		DependsOnTargets="BuildStdBufNativeShim"
		Condition="$([MSBuild]::IsOSPlatform('Linux'))">
		<ItemGroup>
			<ResolvedFileToPublish Include="$(StdBufNativeShimPath)">
				<RelativePath>libicodstdbuf.so</RelativePath>
				<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			</ResolvedFileToPublish>
		</ItemGroup>
	</Target>
</Project>
